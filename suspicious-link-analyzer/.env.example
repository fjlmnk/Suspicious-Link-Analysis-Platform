# =============================================================================
# Suspicious Link Analysis Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# =============================================================================

# --- Database ---
# SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./suspicious_links.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/suspicious_links

# --- Security ---
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- VirusTotal API ---
# Get your API key at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENDPOINT=https://www.virustotal.com/api/v3
VIRUSTOTAL_DAILY_LIMIT=500

# --- Google Safe Browsing API ---
# Get your API key at: https://console.cloud.google.com/apis/credentials
# Enable the Safe Browsing API in your project first.
SAFEBROWSING_API_KEY=
SAFEBROWSING_ENDPOINT=https://safebrowsing.googleapis.com/v4
SAFEBROWSING_DAILY_LIMIT=10000

# --- Rate Limiting ---
MAX_SCANS_PER_HOUR=20

# --- Scan Configuration ---
SCAN_TIMEOUT_SEC=30

# --- Demo Mode ---
# Set to true to enable demo mode (works without API keys)
DEMO_MODE_ENABLED=true

# --- Company Employee Features ---
SECURITY_TEAM_EMAIL=security@company.com
